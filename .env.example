# Secrets live in ".env.local" (same folder as package.json) — never commit that file.
# Setup:  npm run env:init   then   npm run env:edit   (or edit env.local.template in Cursor)
# Required for Prisma + MySQL (see docs/MYSQL_WORKBENCH.md — includes password help).

# With a password (replace YOUR_PASSWORD):
# DATABASE_URL="mysql://root:YOUR_PASSWORD@127.0.0.1:3306/sft_lms"

# XAMPP / empty root password (note root:@ with nothing between : and @):
# DATABASE_URL="mysql://root:@127.0.0.1:3306/sft_lms"

# Cloud (add TLS params per provider):
# DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE?sslaccept=strict"

# Zoom Server-to-Server OAuth (Admin → Tutor Led → create meeting & sync recordings)
# https://marketplace.zoom.us/ → Develop → you will see 4 app types — pick ONLY:
#   "Server-to-Server OAuth" (NOT General App, SDK, or Webhook Only)
# Then add scopes: meeting:write:admin, meeting:read:admin, recording:read:admin, cloud_recording:read:admin
# Copy Account ID, Client ID, Client Secret from the app’s App Credentials tab.
# ZOOM_ACCOUNT_ID=
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=
# ZOOM_HOST_USER_ID=your-zoom-user-id-or-email
# ZOOM_AUTO_RECORD_CLOUD=true

# Email OTP (registration on /account)
# Fast local dev (recommended): instant code on screen, no email attempt
# OTP_USE_SMTP=false
# Without SMTP / OTP_USE_SMTP=false, the code appears on the Register form in development.
# Gmail example: enable 2FA → App passwords → create password for "Mail"
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your@gmail.com
# SMTP_PASS=your-16-char-app-password-no-spaces
# SMTP_FROM="LMS <your@gmail.com>"
# OTP_USE_SMTP=true
# OTP_DEV_LOG=true

# Google Sign-In (Continue with Google on /account)
# https://console.cloud.google.com/apis/credentials → Create OAuth client ID → Web application
# Authorized JavaScript origins: http://localhost:3000
# Authorized redirect URIs: not required for the token flow used here
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Admin dashboard — only MAIN_ADMIN_EMAIL may open /admin (Google sign-in)
# MAIN_ADMIN_EMAIL=your@gmail.com
# ADMIN_EMAILS=your@gmail.com
