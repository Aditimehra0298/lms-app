# Copy to .env.local (same folder as package.json). Never commit .env.local.
# Setup: npm run env:init   then   npm run env:edit

# --- App URL ---
# Local: http://localhost:3000
# Server: https://lms.yourdomain.com  (must match public HTTPS URL)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- MySQL (required) ---
# DATABASE_URL="mysql://root:YOUR_PASSWORD@127.0.0.1:3306/sft_lms"
# XAMPP empty password: mysql://root:@127.0.0.1:3306/sft_lms
# After setting DATABASE_URL, run: npm run db:push  (or prisma migrate deploy)
# Admin saves sync courses + full content (curriculum, video/image URLs) to:
#   lms_course, lms_course_content, lms_media_asset
# Video/image files stay in storage/private/admin/ — NOT public URLs.
# Playback: /api/media/serve/...?t=SIGNED_TOKEN (see MEDIA_SIGNING_SECRET).
# MEDIA_SIGNING_SECRET=long-random-string
# ADMIN_UPLOAD_MAX_VIDEO_MB=5120
# MEDIA_TOKEN_TTL_LEARNER_SECONDS=180
# MEDIA_REQUIRE_SAME_SITE=true
# MEDIA_REQUIRE_MYSQL_ENROLLMENT=true
# MEDIA_TECHNICIAN_ONLY=true
#   When true, media “admin” access is allowed only for users with role='admin' in MySQL (not just guessed admin emails).

# --- Admin ---
# MAIN_ADMIN_EMAIL=your@gmail.com
# ADMIN_EMAILS=your@gmail.com
# ADMIN_PASSWORD="your-password"
# ADMIN_SESSION_SECRET=

# --- Google Sign-In ---
# Authorized JavaScript origins: http://localhost:3000 AND http://YOUR_LAN_IP:3000 (Wi-Fi sharing)
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Enable YouTube Data API v3 in Google Cloud for optional YouTube recommendations.
# Add scope https://www.googleapis.com/auth/youtube.readonly on OAuth consent screen.
# GOOGLE_YOUTUBE_API_KEY=optional-api-key-for-quota

# --- Email (OTP + welcome after registration / Google sign-up) ---
# MAIL_APP_NAME="Sustainable Futures Trainings"
# MAIL_SHORT_BRAND=SFT
# MAIL_TAGLINE="Helping Businesses and Professionals Achieve Excellence"
# Default logo (Cloudinary — works in Gmail):
# MAIL_LOGO_URL=https://res.cloudinary.com/dwnnakrrh/image/upload/v1780117597/SF-WHITE-LOGO_elrbzm.png
# WELCOME_EMAIL_ENABLED=true
# OTP_USE_SMTP=true
# Set false only for local dev without SMTP (codes log to terminal, not inbox).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM="LMS <your@gmail.com>"
# OTP_DEV_LOG=true

# --- AI chatbot (OpenAI preferred when both set) ---
# OPENAI_API_KEY=sk-...
# OPENAI_ASSISTANT_ID=asst_...
# OPENAI_CHAT_MODEL=gpt-4o-mini

# --- n8n certificate webhook (POST on download / generate) ---
N8N_CERTIFICATE_WEBHOOK_URL=https://damnart-ai-guladab.n8n-wsk.com/webhook/certificate
# LMS base URL n8n uses for callback (must be reachable from n8n cloud)
# NEXT_PUBLIC_APP_URL=http://192.168.1.77:3000
# N8N_CALLBACK_BASE_URL=http://192.168.1.77:3000
# CERTIFICATE_LOCAL_FALLBACK=true

# --- n8n (chat, welcome, abandoned cart) ---
# N8N_CHAT_WEBHOOK_URL=https://your-n8n.com/webhook/lms-chat
# CHAT_PROVIDER=auto
# auto = try n8n → openai → local MySQL fallback | n8n | openai | local
# N8N_WELCOME_WEBHOOK_URL=https://your-n8n.com/webhook/welcome-email
# --- n8n transactional email webhooks (POST JSON from backend only — never from browser) ---
# N8N_WEBHOOK_BASE_URL=https://damnart-ai-guladab.n8n-wsk.com/webhook/
# N8N_WEBHOOK_AUTH_MODE=basic
# N8N_WEBHOOK_USER=your_n8n_webhook_username
# N8N_WEBHOOK_PASSWORD=your_n8n_webhook_password
# Aliases supported: N8N_USER / N8N_PASS
# PURCHASE_CONFIRMATION_EMAIL_ENABLED=true
# COURSE_LIFECYCLE_EMAIL_ENABLED=true
# MEETING_REMINDER_EMAIL_ENABLED=true
# N8N_FEEDBACK_EMAIL_DELAY_HOURS=72
# N8N_MEETING_REMINDER_LEAD_MINUTES=10
# CRON_SECRET=long-random-string
# Purchase confirmation (after payment + enrollment)
# N8N_TUTOR_LED_PURCHASE_WEBHOOK_URL=https://damnart-ai-guladab.n8n-wsk.com/webhook/purchased(tutor%20led)
# N8N_SELF_PACED_PURCHASE_WEBHOOK_URL=https://damnart-ai-guladab.n8n-wsk.com/webhook/payment-confirmation(self-based)
# Course completion + delayed feedback (cron: GET /api/cron/n8n-emails)
# N8N_COURSE_COMPLETION_WEBHOOK_URL=https://damnart-ai-guladab.n8n-wsk.com/webhook/course-completed
# COURSE_LIFECYCLE_EMAIL_ENABLED=true
# Progress report email (milestones 25/50/75/100% + module complete; also POST /api/learner/progress-report)
# N8N_PROGRESS_REPORT_WEBHOOK_URL=https://damnart-ai-guladab.n8n-wsk.com/webhook/progress-report
# COURSE_PROGRESS_EMAIL_ENABLED=true
# Module completed + exam passed email (fires when exam first passes)
# N8N_MODULE_COMPLETED_WEBHOOK_URL=https://damnart-ai-guladab.n8n-wsk.com/webhook/module%20completed
# MODULE_COMPLETED_EMAIL_ENABLED=true
# Password reset (Forgot password + admin Users → Send password reset email)
# N8N_PASSWORD_RESET_WEBHOOK_URL=https://damnart-ai-guladab.n8n-wsk.com/webhook/password-reset
# PASSWORD_RESET_EMAIL_ENABLED=true
# PASSWORD_RESET_TTL_HOURS=24
# Optional public base for links.reset (defaults to NEXT_PUBLIC_APP_URL)
# PASSWORD_RESET_BASE_URL=https://www.sftrainings.org
# N8N_REVIEWS_WEBHOOK_URL=https://damnart-ai-guladab.n8n-wsk.com/webhook/reviews
# N8N_MEETING_REMINDER_WEBHOOK_URL=https://damnart-ai-guladab.n8n-wsk.com/webhook/meeting-reminder
# Abandoned cart recovery email (production)
# N8N_ABANDONED_CART_WEBHOOK_URL=https://damnart-ai-guladab.n8n-wsk.com/webhook/abandoned-cart
# N8N_NEWSLETTER_WEBHOOK_URL=https://damnart-ai-guladab.n8n-wsk.com/webhook/newsletter
# NEXT_PUBLIC_ABANDONED_CART_DELAY_MINUTES=30
# Webhook HTTP Basic Auth (same user/password as in n8n Webhook node → Authentication)
# N8N_WEBHOOK_USER=your_n8n_webhook_username
# N8N_WEBHOOK_PASSWORD=your_n8n_webhook_password
# Optional extra header (LMS → n8n); n8n can check X-Webhook-Secret in workflow
# N8N_WEBHOOK_SECRET=

# --- Razorpay (checkout payments) ---
# Full setup: docs/RAZORPAY_SETUP.md
# Dashboard: https://dashboard.razorpay.com/app/keys
# Test keys (rzp_test_…) on localhost; live keys (rzp_live_…) on HTTPS production only.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# RAZORPAY_KEY_SECRET=your_secret_key
# Optional fallback if a learner region currency is unsupported (usually not needed)
# RAZORPAY_CURRENCY=INR

# --- Zoom (optional) ---
# ZOOM_ACCOUNT_ID=
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=
# ZOOM_HOST_USER_ID=
# ZOOM_AUTO_RECORD_CLOUD=true
