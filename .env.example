# Copy to .env.local (same folder as package.json). Never commit .env.local.
# Setup: npm run env:init   then   npm run env:edit

# --- App URL ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- MySQL (required) ---
# DATABASE_URL="mysql://root:YOUR_PASSWORD@127.0.0.1:3306/sft_lms"
# XAMPP empty password: mysql://root:@127.0.0.1:3306/sft_lms

# --- Admin ---
# MAIN_ADMIN_EMAIL=your@gmail.com
# ADMIN_EMAILS=your@gmail.com
# ADMIN_PASSWORD="your-password"
# ADMIN_SESSION_SECRET=

# --- Google Sign-In ---
# Authorized JavaScript origins: http://localhost:3000
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# --- Email OTP ---
# OTP_USE_SMTP=false
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM="LMS <your@gmail.com>"
# OTP_DEV_LOG=true

# --- AI chatbot (OpenAI preferred when both set) ---
# OPENAI_API_KEY=sk-...
# OPENAI_ASSISTANT_ID=asst_...

# --- n8n ---
# N8N_CERTIFICATE_WEBHOOK_URL=https://your-n8n.com/webhook/certificate
# N8N_CHAT_WEBHOOK_URL=https://your-n8n.com/webhook/lms-chat
# N8N_WEBHOOK_SECRET=

# --- Zoom (optional) ---
# ZOOM_ACCOUNT_ID=
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=
# ZOOM_HOST_USER_ID=
# ZOOM_AUTO_RECORD_CLOUD=true
