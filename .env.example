# Copy to .env.local (same folder as package.json). Never commit .env.local.
# Setup: npm run env:init   then   npm run env:edit

# --- App URL ---
# Local: http://localhost:3000
# Server: https://lms.yourdomain.com  (must match public HTTPS URL)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- MySQL (required) ---
# DATABASE_URL="mysql://root:YOUR_PASSWORD@127.0.0.1:3306/sft_lms"
# XAMPP empty password: mysql://root:@127.0.0.1:3306/sft_lms
# After setting DATABASE_URL, run: npm run db:push  (or prisma migrate deploy)
# Admin saves sync courses + full content (curriculum, video/image URLs) to:
#   lms_course, lms_course_content, lms_media_asset
# Video/image files stay in storage/private/admin/ — NOT public URLs.
# Playback: /api/media/serve/...?t=SIGNED_TOKEN (see MEDIA_SIGNING_SECRET).
# MEDIA_SIGNING_SECRET=long-random-string
# ADMIN_UPLOAD_MAX_VIDEO_MB=5120
# MEDIA_REQUIRE_MYSQL_ENROLLMENT=true
# MEDIA_TECHNICIAN_ONLY=true
#   When true, media “admin” access is allowed only for users with role='admin' in MySQL (not just guessed admin emails).

# --- Admin ---
# MAIN_ADMIN_EMAIL=your@gmail.com
# ADMIN_EMAILS=your@gmail.com
# ADMIN_PASSWORD="your-password"
# ADMIN_SESSION_SECRET=

# --- Google Sign-In ---
# Authorized JavaScript origins: http://localhost:3000 AND http://YOUR_LAN_IP:3000 (Wi-Fi sharing)
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# --- Email (OTP + welcome after registration / Google sign-up) ---
# MAIL_APP_NAME="SF Trainings"
# MAIL_SHORT_BRAND=SFT
# WELCOME_EMAIL_ENABLED=true
# OTP_USE_SMTP=false
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM="LMS <your@gmail.com>"
# OTP_DEV_LOG=true

# --- AI chatbot (OpenAI preferred when both set) ---
# OPENAI_API_KEY=sk-...
# OPENAI_ASSISTANT_ID=asst_...

# --- n8n ---
# N8N_CERTIFICATE_WEBHOOK_URL=https://your-n8n.com/webhook/certificate
# N8N_CHAT_WEBHOOK_URL=https://your-n8n.com/webhook/lms-chat
# N8N_WELCOME_WEBHOOK_URL=https://your-n8n.com/webhook/welcome
# Webhook HTTP Basic Auth (same user/password as in n8n Webhook node → Authentication)
# N8N_WEBHOOK_USER=your_n8n_webhook_username
# N8N_WEBHOOK_PASSWORD=your_n8n_webhook_password
# Optional extra header (LMS → n8n); n8n can check X-Webhook-Secret in workflow
# N8N_WEBHOOK_SECRET=

# --- Zoom (optional) ---
# ZOOM_ACCOUNT_ID=
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=
# ZOOM_HOST_USER_ID=
# ZOOM_AUTO_RECORD_CLOUD=true
