{
  "name": "sft-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --webpack -p 3000",
    "dev:turbo": "next dev --hostname 0.0.0.0 -p 3000",
    "dev:fresh": "pkill -f 'next dev' 2>/dev/null || true; rm -rf .next; next dev --hostname 0.0.0.0 --webpack -p 3000",
    "dev:fresh:turbo": "pkill -f 'next dev' 2>/dev/null || true; rm -rf .next; next dev --hostname 0.0.0.0 -p 3000",
    "build": "node --use-system-ca ./node_modules/prisma/build/index.js generate && next build --webpack",
    "build:turbo": "next build",
    "start": "next start",
    "start:server": "next start -H 0.0.0.0 -p 3000",
    "studio:server": "prisma studio --hostname 127.0.0.1 --port 5555 --browser none",
    "lint": "eslint",
    "postinstall": "node scripts/postinstall.mjs",
    "clean:node_modules": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/clean-node-modules.ps1",
    "db:generate": "node --use-system-ca ./node_modules/prisma/build/index.js generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:deploy": "prisma migrate deploy",
    "env:init": "node scripts/init-env-local.mjs",
    "env:edit": "node scripts/open-env-local.mjs",
    "setup:otp": "prisma db push && prisma generate && npm run install:nodemailer",
    "install:nodemailer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-nodemailer.ps1",
    "install:nodemailer:offline": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-nodemailer-offline.ps1"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.64",
    "@ai-sdk/react": "^3.0.193",
    "@prisma/client": "^6.19.0",
    "@swc/helpers": "^0.5.21",
    "ai": "^6.0.188",
    "lucide-react": "^1.14.0",
    "nanoid": "^3.3.11",
    "next": "16.2.3",
    "nodemailer": "^6.10.1",
    "openai": "^6.38.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-easy-crop": "^5.5.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "20.19.39",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "19.2.14",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "napi-postinstall": "^0.3.4",
    "postcss": "8.4.49",
    "prisma": "^6.19.0",
    "tailwindcss": "^4",
    "typescript": "5.9.3"
  }
}
