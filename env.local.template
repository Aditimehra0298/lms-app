# Copy to .env.local in this folder (same folder as package.json).
# npm run env:init   |   npm run env:edit

# --- App URL ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- MySQL (required) ---
DATABASE_URL="mysql://root:YOUR_PASSWORD@127.0.0.1:3306/sft_lms"

# --- Admin ---
MAIN_ADMIN_EMAIL=your@gmail.com
ADMIN_EMAILS=your@gmail.com
ADMIN_PASSWORD="your-password"

# --- Google Sign-In ---
# Authorized JavaScript origins: http://localhost:3000
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Email OTP ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="LMS <your@gmail.com>"
OTP_USE_SMTP=true
OTP_DEV_LOG=true

# --- AI chatbot ---
OPENAI_API_KEY=
OPENAI_ASSISTANT_ID=

# --- n8n (optional) ---
N8N_CERTIFICATE_WEBHOOK_URL=
N8N_CHAT_WEBHOOK_URL=

# --- Zoom (optional) ---
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_HOST_USER_ID=
ZOOM_AUTO_RECORD_CLOUD=true
